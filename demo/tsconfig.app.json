{
  "compilerOptions": {
    "downlevelIteration": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "outDir": "../out-tsc/app",
    "target": "ES2022",
    "module": "es2020",
    "types": [],
    "baseUrl": ".",
    "rootDir": "../",
    "paths": {
      "ngx-jsonapi": [
        "../projects/ngx-jsonapi-lib/src/public_api.ts"
      ],
      "ngx-jsonapi/*": [
        "../src/*"
      ]
    },
    "useDefineForClassFields": false
  },
  "files": [
    "main.ts",
    "polyfills.ts"
  ],
  "include": [
    "demo/**/*.d.ts"
  ]
}
