{
    "compilerOptions": {
      "downlevelIteration": true,
      "importHelpers": true,
      "strictNullChecks": true,
      "sourceMap": true,
      "declaration": false,
      "moduleResolution": "node",
      "experimentalDecorators": true,
      "noStrictGenericChecks": true,
      "lib": [
        "es2017",
        "dom"
      ],
      "outDir": "../out-tsc/app",
      "target": "ES2022",
      "module": "commonjs",
      "baseUrl": "",
      "rootDir": "./",
      "paths": {
        "ngx-jsonapi": [
          "./src"
        ]
      },
      "strict": false,
      "useDefineForClassFields": false
    },
    "exclude": [
        "node_modules",
        "**/*/node_modules",
        "src/schematics/src/*/files/**/*"
    ],
    "compileOnSave": false,
    "buildOnSave": false,
    "atom": {
        "rewriteTsconfig": false
    }
}
